@using ObsProje.Models.ViewModels;
@model LoginVM
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>İdare Girişi</title>
    <link href="~/css/centerdiv.css" rel="stylesheet" />
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f4;
            text-align: center;
            padding: 50px;
        }

        h1 {
            color: #333;
        }

        .login-container {
            max-width: 400px;
            margin: 0 auto;
            background-color: #fff;
            padding: 20px;
            border-radius: 5px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-weight: bold;
        }

        input {
            width: 100%;
            padding: 10px;
            margin-bottom: 15px;
            box-sizing: border-box;
        }

        .login-button {
            display: inline-block;
            padding: 10px 20px;
            font-size: 16px;
            text-align: center;
            text-decoration: none;
            background-color: #4285f4;
            color: #ffffff;
            border-radius: 5px;
            cursor: pointer;
        }
    </style>
</head>
<body>
    <h1>İdare Girişi</h1>

    

    <div class="container">
        <div class="centered-div">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Giriş Yap</h3>
                    @{
                        if (TempData["loginfailed"] != null)
                        {
                            <div class="alert alert-danger">
                                @TempData["loginfailed"]
                            </div>
                        }
                    }
                </div>
                <form method="post">
                    <div class="card-body">
                        <div class="form-group">
                            <label>Kullanıcı Adı</label>
                            <input asp-for="UserName" id="myUserNameInput" autocomplete="off" type="text" class="form-control" placeholder="Kullanıcı Adı">
                            <span style="color:red" asp-validation-for="UserName"></span>
                        </div>
                        <div class="form-group">
                            <label>Şifre</label>
                            <input asp-for="Password" id="myPasswordInput" autocomplete="off" type="password" class="form-control" placeholder="Şifre">
                            <span style="color:red" asp-validation-for="Password"></span>
                        </div>
                    </div>
                    <div class="card-footer">
                        <button type="submit" id="idariGirisBtn" class="btn btn-primary">Giriş Yap</button>
                        <button asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-primary" style="float:right">Geri</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    
</body>
</html>

