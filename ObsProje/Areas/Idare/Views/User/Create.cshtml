@using ObsProje.Models.ViewModels
@model UserVM;

<div class="container">
    <div class="centered-div">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Yeni Kullanıcı Oluşturma</h3>
            </div>
            <form method="post">
                <div class="card-body">
                    <div class="form-group">
                        <label>Kullanıcı Adı</label>
                        <input id="myInput" autocomplete="off" asp-for="UserName" type="text" class="form-control" placeholder="Kullanıcı Adı">
                        <span style="color:red" asp-validation-for="UserName"></span>
                    </div>
                    <div class="form-group">
                        <label>Şifre</label>
                        <input id="myInput" autocomplete="off" asp-for="Password" type="password" class="form-control" placeholder="Şifre">
                        <span style="color:red" asp-validation-for="Password"></span>
                    </div>
                    <div class="form-group">
                        <label> Adı</label>
                        <input id="myInput" autocomplete="off" asp-for="Name" type="text" class="form-control" placeholder="Adı">
                        <span style="color:red" asp-validation-for="Name"></span>
                    </div>
                    <div class="form-group">
                        <label>Soyadı</label>
                        <input id="myInput" autocomplete="off" asp-for="Surname" type="text" class="form-control" placeholder="Soyadı">
                        <span style="color:red" asp-validation-for="Surname"></span>
                    </div>
                    <div class="form-group">
                        <label>E-Mail</label>
                        <input id="myInput" autocomplete="off" asp-for="Email" type="email" class="form-control" placeholder="E-Mail">
                        <span style="color:red" asp-validation-for="Email"></span>
                    </div>
                    <div class="form-group">
                        <label>Telefon Numarası</label>
                        <input id="myInput" autocomplete="off" asp-for="TelNo" type="text" class="form-control" placeholder="Telefon Numarası">
                        <span style="color:red" asp-validation-for="TelNo"></span>
                    </div>
                    <div class="form-group">
                        <label>Adres</label>
                        <input id="myInput" autocomplete="off" asp-for="Address" type="text" class="form-control" placeholder="Adres">
                        <span style="color:red" asp-validation-for="Address"></span>
                    </div>
                    <div class="form-group">
                        <label>TC Kimlik Numarası</label>
                        <input id="myInput" autocomplete="off" asp-for="TCKN" type="text" class="form-control" placeholder="TC Kimlik Numarası">
                        <span style="color:red" asp-validation-for="TCKN"></span>
                    </div>
                    <div class="form-group">
                        <label>Kullanıcı Rolü</label>
                        <select class="form-select form-select-sm">
                            @foreach(var _role in Model.Roles)
                            {
                                <option value="@_role.Value">@_role.Text</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="card-footer">
                    <button onclick="checkInput()" type="submit" class="btn btn-primary">Kullanıcı Oluştur</button>
                    <button asp-area="Idare" asp-controller="User" asp-action="Index" class="btn btn-primary" style="float:right">Geri</button>
                </div>
            </form>
        </div>
    </div>
</div>